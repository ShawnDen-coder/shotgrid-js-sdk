{
  "name": "shotgrid-js-sdk",
  "version": "1.1.2",
  "type": "module",
  "description": "JavaScript/TypeScript SDK for the ShotGrid REST API",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "fmt": "prettier . --write",
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "axios": "^1.0.0",
    "tslog": "^4.0.0"
  },
  "devDependencies": {
    "axios": "^1.13.6",
    "prettier": "^3.8.1",
    "tslog": "^4.10.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-node": "^5.3.0",
    "vite-plugin-dts": "^4.5.4"
  }
}
