VITE_SHOTGRID_BASE_URL=https://your-site.shotgunstudio.com
VITE_SHOTGRID_API_VERSION=v1.1
VITE_SHOTGRID_GRANT_TYPE=client_credentials

# client_credentials
VITE_SHOTGRID_CLIENT_ID=your_script_name
VITE_SHOTGRID_CLIENT_SECRET=your_script_key

# password
VITE_SHOTGRID_USERNAME=
VITE_SHOTGRID_PASSWORD=
VITE_SHOTGRID_AUTH_TOKEN=

# session_token
VITE_SHOTGRID_SESSION_TOKEN=
